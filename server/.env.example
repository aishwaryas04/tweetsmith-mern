# Copy this file to ".env" and fill in your values.

PORT=5000

# Which AI to use: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# If LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=paste-your-key-here
ANTHROPIC_MODEL=claude-sonnet-5-5

# If LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional. Leave empty to run without a database (history is then switched off).
# Local example: mongodb://127.0.0.1:27017/tweetsmith
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tweetsmith
MONGO_URI=mongodb://127.0.0.1:27017/tweetsmith
